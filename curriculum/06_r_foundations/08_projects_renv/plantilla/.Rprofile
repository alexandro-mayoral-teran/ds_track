# Configuracion de esta copia del proyecto, aplicada solo al proceso R.
Sys.setenv(
  RENV_PATHS_ROOT = file.path(getwd(), ".renv-local"),
  RENV_PATHS_SANDBOX = file.path(getwd(), ".renv-local", "sandbox"),
  RENV_CONFIG_CACHE_ENABLED = "FALSE",
  RENV_CONFIG_USER_ENVIRON = "FALSE",
  RENV_CONFIG_USER_PROFILE = "FALSE"
)
source("renv/activate.R")
